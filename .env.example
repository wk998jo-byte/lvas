# Server-only. Never commit real values.

# PostgreSQL (Replit Secrets / local)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Pin the admin profile that receives new requests (existing profile UUID)
APPROVER_USER_ID=

# First-time admin password bootstrap (used only if that profile has no password_hash)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Initial password for new logistics accounts (or profiles with a null hash).
# Re-running bootstrap does not overwrite an existing password.
LOGISTICS_APPROVER_PASSWORD=

# Optional: protect /api/cron/expiry-alarms
CRON_SECRET=

# Password reset email. APP_URL is the public site address used in the link.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LVAS <noreply@binquraya.com>
