# Server-only. Never commit real values.

# PostgreSQL (Replit Secrets / local)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Pin the admin profile that receives new requests (existing profile UUID)
APPROVER_USER_ID=

# First-time admin password bootstrap (used only if that profile has no password_hash)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional: protect /api/cron/expiry-alarms
CRON_SECRET=
